[Unit]
Description=Kuru Record finalization and Drive/R2 transfers
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/kuru-record

[Service]
User=kuru-record
Group=kuru-record
WorkingDirectory=/opt/kuru-record
EnvironmentFile=/etc/kuru-record/media.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kuru-record/.venv/bin/python record_worker_media.py --spool /var/lib/kuru-record
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=300
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
